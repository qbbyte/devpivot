<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.mapper.AiEditHistoryMapper">

    <resultMap type="AiEditHistory" id="AiEditHistoryResult">
        <result property="historyId"     column="history_id"     />
        <result property="projectId"     column="project_id"     />
        <result property="stage"         column="stage"          />
        <result property="artifactType"  column="artifact_type"  />
        <result property="artifactId"    column="artifact_id"    />
        <result property="versionId"     column="version_id"     />
        <result property="versionNo"     column="version_no"     />
        <result property="action"        column="action"         />
        <result property="actionDesc"    column="action_desc"    />
        <result property="operatorId"    column="operator_id"    />
        <result property="operatorName"  column="operator_name"  />
        <result property="targetLabel"   column="target_label"   />
        <result property="changeSummary" column="change_summary" />
        <result property="changeDetail"  column="change_detail"  />
        <result property="ip"            column="ip"             />
        <result property="client"        column="client"         />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectAiEditHistoryVo">
        select history_id, project_id, stage, artifact_type, artifact_id, version_id, version_no,
               action, action_desc, operator_id, operator_name, target_label, change_summary,
               change_detail, ip, client, create_time
        from ai_edit_history
    </sql>

    <select id="selectAiEditHistoryList" parameterType="AiEditHistory" resultMap="AiEditHistoryResult">
        <include refid="selectAiEditHistoryVo"/>
        <where>
            <if test="projectId != null"> and project_id = #{projectId}</if>
            <if test="stage != null and stage != ''"> and stage = #{stage}</if>
            <if test="versionId != null"> and version_id = #{versionId}</if>
            <if test="operatorId != null"> and operator_id = #{operatorId}</if>
            <if test="params.startTime != null and params.startTime != ''"> and create_time &gt;= #{params.startTime}</if>
            <if test="params.endTime != null and params.endTime != ''"> and create_time &lt;= #{params.endTime}</if>
        </where>
        order by history_id desc
    </select>

    <insert id="insertAiEditHistory" parameterType="AiEditHistory" useGeneratedKeys="true" keyProperty="historyId">
        insert into ai_edit_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="stage != null">stage,</if>
            <if test="artifactType != null">artifact_type,</if>
            <if test="artifactId != null">artifact_id,</if>
            <if test="versionId != null">version_id,</if>
            <if test="versionNo != null">version_no,</if>
            <if test="action != null">action,</if>
            <if test="actionDesc != null">action_desc,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="operatorName != null">operator_name,</if>
            <if test="targetLabel != null">target_label,</if>
            <if test="changeSummary != null">change_summary,</if>
            <if test="changeDetail != null">change_detail,</if>
            <if test="ip != null">ip,</if>
            <if test="client != null">client,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="stage != null">#{stage},</if>
            <if test="artifactType != null">#{artifactType},</if>
            <if test="artifactId != null">#{artifactId},</if>
            <if test="versionId != null">#{versionId},</if>
            <if test="versionNo != null">#{versionNo},</if>
            <if test="action != null">#{action},</if>
            <if test="actionDesc != null">#{actionDesc},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="operatorName != null">#{operatorName},</if>
            <if test="targetLabel != null">#{targetLabel},</if>
            <if test="changeSummary != null">#{changeSummary},</if>
            <if test="changeDetail != null">#{changeDetail},</if>
            <if test="ip != null">#{ip},</if>
            <if test="client != null">#{client},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <select id="selectRecent" resultMap="AiEditHistoryResult">
        <include refid="selectAiEditHistoryVo"/>
        where project_id = #{projectId}
        order by history_id desc
        limit #{limit}
    </select>

    <select id="selectAggregateByOperator" resultType="java.util.Map">
        select operator_id as operatorId,
               max(operator_name) as operatorName,
               count(*) as totalOps,
               sum(case when action in ('CREATE','RELEASE','RESTORE','DELETE') then 1 else 0 end) as versionOps,
               max(create_time) as lastActive
        from ai_edit_history
        where project_id = #{projectId}
        <if test="startTime != null"> and create_time &gt;= #{startTime}</if>
        group by operator_id
        order by totalOps desc
    </select>
</mapper>
