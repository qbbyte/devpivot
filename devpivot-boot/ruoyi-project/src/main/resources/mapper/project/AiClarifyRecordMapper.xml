<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.mapper.AiClarifyRecordMapper">
    
    <resultMap type="AiClarifyRecord" id="AiClarifyRecordResult">
        <result property="recordId"    column="record_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="category"    column="category"    />
        <result property="question"    column="question"    />
        <result property="answer"    column="answer"    />
        <result property="status"    column="status"    />
        <result property="sourceModel"    column="source_model"    />
        <result property="highlightType"    column="highlight_type"    />
        <result property="modelList"    column="model_list"    />
        <result property="isMerged"    column="is_merged"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectAiClarifyRecordVo">
        select record_id, project_id, category, question, answer, status, source_model, highlight_type, model_list, is_merged, create_by, create_time, update_by, update_time, remark from ai_clarify_record
    </sql>

    <select id="selectAiClarifyRecordList" parameterType="AiClarifyRecord" resultMap="AiClarifyRecordResult">
        <include refid="selectAiClarifyRecordVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="category != null  and category != ''"> and category = #{category}</if>
            <if test="question != null  and question != ''"> and question = #{question}</if>
            <if test="answer != null  and answer != ''"> and answer = #{answer}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="sourceModel != null  and sourceModel != ''"> and source_model = #{sourceModel}</if>
            <if test="highlightType != null  and highlightType != ''"> and highlight_type = #{highlightType}</if>
            <if test="modelList != null  and modelList != ''"> and model_list = #{modelList}</if>
            <if test="isMerged != null  and isMerged != ''"> and is_merged = #{isMerged}</if>
        </where>
    </select>
    
    <select id="selectAiClarifyRecordByRecordId" parameterType="Long" resultMap="AiClarifyRecordResult">
        <include refid="selectAiClarifyRecordVo"/>
        where record_id = #{recordId}
    </select>

    <insert id="insertAiClarifyRecord" parameterType="AiClarifyRecord" useGeneratedKeys="true" keyProperty="recordId">
        insert into ai_clarify_record
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="category != null">category,</if>
            <if test="question != null">question,</if>
            <if test="answer != null">answer,</if>
            <if test="status != null">status,</if>
            <if test="sourceModel != null">source_model,</if>
            <if test="highlightType != null">highlight_type,</if>
            <if test="modelList != null">model_list,</if>
            <if test="isMerged != null">is_merged,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="category != null">#{category},</if>
            <if test="question != null">#{question},</if>
            <if test="answer != null">#{answer},</if>
            <if test="status != null">#{status},</if>
            <if test="sourceModel != null">#{sourceModel},</if>
            <if test="highlightType != null">#{highlightType},</if>
            <if test="modelList != null">#{modelList},</if>
            <if test="isMerged != null">#{isMerged},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAiClarifyRecord" parameterType="AiClarifyRecord">
        update ai_clarify_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="category != null">category = #{category},</if>
            <if test="question != null">question = #{question},</if>
            <if test="answer != null">answer = #{answer},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sourceModel != null">source_model = #{sourceModel},</if>
            <if test="highlightType != null">highlight_type = #{highlightType},</if>
            <if test="modelList != null">model_list = #{modelList},</if>
            <if test="isMerged != null">is_merged = #{isMerged},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where record_id = #{recordId}
    </update>

    <delete id="deleteAiClarifyRecordByRecordId" parameterType="Long">
        delete from ai_clarify_record where record_id = #{recordId}
    </delete>

    <delete id="deleteAiClarifyRecordByRecordIds" parameterType="String">
        delete from ai_clarify_record where record_id in 
        <foreach item="recordId" collection="array" open="(" separator="," close=")">
            #{recordId}
        </foreach>
    </delete>
</mapper>