<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.ai.mapper.AiParallelTaskMapper">
    
    <resultMap type="AiParallelTask" id="AiParallelTaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="projectId"    column="project_id"    />
        <result property="taskType"    column="task_type"    />
        <result property="modelIds"    column="model_ids"    />
        <result property="requestParams"    column="request_params"    />
        <result property="resultSummary"    column="result_summary"    />
        <result property="compareResult"    column="compare_result"    />
        <result property="status"    column="status"    />
        <result property="estTokens"    column="est_tokens"    />
        <result property="totalTokens"    column="total_tokens"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectAiParallelTaskVo">
        select task_id, project_id, task_type, model_ids, request_params, result_summary, compare_result, status, est_tokens, total_tokens, create_by, create_time, update_by, update_time, remark from ai_parallel_task
    </sql>

    <select id="selectAiParallelTaskList" parameterType="AiParallelTask" resultMap="AiParallelTaskResult">
        <include refid="selectAiParallelTaskVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="taskType != null  and taskType != ''"> and task_type = #{taskType}</if>
            <if test="modelIds != null  and modelIds != ''"> and model_ids = #{modelIds}</if>
            <if test="requestParams != null  and requestParams != ''"> and request_params = #{requestParams}</if>
            <if test="resultSummary != null  and resultSummary != ''"> and result_summary = #{resultSummary}</if>
            <if test="compareResult != null  and compareResult != ''"> and compare_result = #{compareResult}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="estTokens != null "> and est_tokens = #{estTokens}</if>
            <if test="totalTokens != null "> and total_tokens = #{totalTokens}</if>
        </where>
    </select>
    
    <select id="selectAiParallelTaskByTaskId" parameterType="Long" resultMap="AiParallelTaskResult">
        <include refid="selectAiParallelTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertAiParallelTask" parameterType="AiParallelTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into ai_parallel_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="taskType != null and taskType != ''">task_type,</if>
            <if test="modelIds != null">model_ids,</if>
            <if test="requestParams != null">request_params,</if>
            <if test="resultSummary != null">result_summary,</if>
            <if test="compareResult != null">compare_result,</if>
            <if test="status != null">status,</if>
            <if test="estTokens != null">est_tokens,</if>
            <if test="totalTokens != null">total_tokens,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="taskType != null and taskType != ''">#{taskType},</if>
            <if test="modelIds != null">#{modelIds},</if>
            <if test="requestParams != null">#{requestParams},</if>
            <if test="resultSummary != null">#{resultSummary},</if>
            <if test="compareResult != null">#{compareResult},</if>
            <if test="status != null">#{status},</if>
            <if test="estTokens != null">#{estTokens},</if>
            <if test="totalTokens != null">#{totalTokens},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateAiParallelTask" parameterType="AiParallelTask">
        update ai_parallel_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="taskType != null and taskType != ''">task_type = #{taskType},</if>
            <if test="modelIds != null">model_ids = #{modelIds},</if>
            <if test="requestParams != null">request_params = #{requestParams},</if>
            <if test="resultSummary != null">result_summary = #{resultSummary},</if>
            <if test="compareResult != null">compare_result = #{compareResult},</if>
            <if test="status != null">status = #{status},</if>
            <if test="estTokens != null">est_tokens = #{estTokens},</if>
            <if test="totalTokens != null">total_tokens = #{totalTokens},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteAiParallelTaskByTaskId" parameterType="Long">
        delete from ai_parallel_task where task_id = #{taskId}
    </delete>

    <delete id="deleteAiParallelTaskByTaskIds" parameterType="String">
        delete from ai_parallel_task where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>